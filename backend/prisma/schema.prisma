generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  googleId      String    @unique
  createdAt     DateTime  @default(now())
  gameHistory   Game[]
}

model Game {
  id            String    @id @default(uuid())
  userId        String
  word          String
  guesses       Int
  won           Boolean
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id])
} 